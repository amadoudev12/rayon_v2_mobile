# Adresse du backend (API), sans « / » final.
# En développement sur un vrai téléphone : l'adresse IP locale de l'ordinateur
# qui exécute le backend, PAS localhost (ex : http://192.168.1.85:4000).
# Émulateur Android : http://10.0.2.2:4000 — Simulateur iOS : http://localhost:4000
# En production : l'URL HTTPS du backend déployé.
EXPO_PUBLIC_API_URL=http://192.168.1.85:4000

# Adresse du site web (frontend), sans « / » final : ouverte par le lien
# « Créer un compte sur le site » de l'écran de connexion.
EXPO_PUBLIC_WEB_URL=http://192.168.1.85:5173
